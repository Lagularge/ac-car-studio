<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AC-Car-Studio</AssemblyName>
    <RootNamespace>AcCarStudioHost</RootNamespace>
    <ApplicationIcon>..\build\icon.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>AC Car Studio</Product>
    <Company>Lagularge</Company>
    <Description>AC Car Studio — Lightweight Native WebView2 Edition</Description>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="EmbeddedAssets\dist.zip" LogicalName="dist.zip" Condition="Exists('EmbeddedAssets\dist.zip')" />
    <EmbeddedResource Include="EmbeddedAssets\Microsoft.Web.WebView2.Core.dll" LogicalName="Microsoft.Web.WebView2.Core.dll" Condition="Exists('EmbeddedAssets\Microsoft.Web.WebView2.Core.dll')" />
    <EmbeddedResource Include="EmbeddedAssets\Microsoft.Web.WebView2.WinForms.dll" LogicalName="Microsoft.Web.WebView2.WinForms.dll" Condition="Exists('EmbeddedAssets\Microsoft.Web.WebView2.WinForms.dll')" />
    <EmbeddedResource Include="EmbeddedAssets\WebView2Loader.dll" LogicalName="WebView2Loader.dll" Condition="Exists('EmbeddedAssets\WebView2Loader.dll')" />
  </ItemGroup>
</Project>
