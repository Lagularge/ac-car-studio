{
  "name": "ac-car-studio",
  "version": "1.0.0",
  "description": "Assetto Corsa 車両作成・物理チューニング・data.acd管理・サーバー設定 デスクトップスタジオ",
  "author": "Lagularge",
  "license": "MIT",
  "homepage": "https://github.com/Lagularge/ac-car-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lagularge/ac-car-studio.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:vite": "vite --port 5173 --strictPort",
    "build:electron": "node scripts/build-electron.mjs",
    "dev": "npm run build:electron && concurrently -k \"npm run dev:vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "build:installer": "node scripts/build-online-installer.mjs",
    "sign": "powershell -ExecutionPolicy Bypass -File scripts/sign-executables.ps1",
    "trust:cert": "powershell -ExecutionPolicy Bypass -File scripts/sign-executables.ps1 -InstallRootTrust",
    "dist": "npm run build && electron-builder --win && npm run build:installer && npm run sign"
  },
  "dependencies": {},
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.2",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "tailwindcss": "^4.1.4",
    "three": "^0.187.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.accarstudio.app",
    "productName": "AC Car Studio",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "!dist-electron/**/*.map",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "AC-Car-Studio-${version}-win-portable.exe"
    }
  }
}
